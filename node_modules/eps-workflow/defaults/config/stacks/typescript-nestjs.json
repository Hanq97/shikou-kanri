{
  "$comment": "TypeScript NestJS stack",
  "name": "TypeScript NestJS",
  "language": "typescript",
  "framework": "nestjs",
  "version": { "typescript": "5.x", "nestjs": "10.x" },
  "extensions": [".ts"],
  "parsing": {
    "parser": "typescript-parser",
    "extractor": "nestjs-extractor",
    "patterns": {
      "controller": { "decorators": ["Controller"], "nameSuffix": ["Controller"], "nodeType": "Controller" },
      "service": { "decorators": ["Injectable"], "nameSuffix": ["Service"], "nodeType": "Service" },
      "module": { "decorators": ["Module"], "nameSuffix": ["Module"], "nodeType": "Component" },
      "guard": { "decorators": ["Injectable"], "interfaces": ["CanActivate"], "nameSuffix": ["Guard"], "nodeType": "Component" },
      "interceptor": { "decorators": ["Injectable"], "interfaces": ["NestInterceptor"], "nameSuffix": ["Interceptor"], "nodeType": "Component" },
      "pipe": { "decorators": ["Injectable"], "interfaces": ["PipeTransform"], "nameSuffix": ["Pipe"], "nodeType": "Component" }
    },
    "decorators": {
      "http": { "GET": ["Get"], "POST": ["Post"], "PUT": ["Put"], "DELETE": ["Delete"], "PATCH": ["Patch"] },
      "injection": ["Inject", "InjectRepository"],
      "validation": ["UsePipes", "ValidationPipe"]
    }
  },
  "architecture": {
    "supportedArchitectures": ["modular", "clean-architecture", "cqrs", "hexagonal"],
    "defaultArchitecture": null,
    "autoDetection": {
      "modular": { "requiredPattern": "*.module.ts", "indicators": ["@Module", "@Controller", "@Injectable"], "confidence": 0.85 },
      "cqrs": { "requiredDirs": ["commands", "queries", "events"], "indicators": ["@CommandHandler", "@QueryHandler", "@EventsHandler"], "confidence": 0.9 },
      "hexagonal": { "requiredDirs": ["domain", "ports", "adapters"], "confidence": 0.85 }
    },
    "layerMappings": {
      "modular": {
        "module": { "pathPatterns": ["**/*.module.ts"], "markers": ["@Module"], "stereotype": "Module" },
        "controller": { "pathPatterns": ["**/*.controller.ts"], "markers": ["@Controller"], "stereotype": "Controller" },
        "service": { "pathPatterns": ["**/*.service.ts"], "markers": ["@Injectable"], "stereotype": "Service" },
        "repository": { "pathPatterns": ["**/*.repository.ts"], "markers": ["@Injectable", "@InjectRepository"], "stereotype": "Repository" },
        "entity": { "pathPatterns": ["**/*.entity.ts"], "markers": ["@Entity"], "stereotype": "Entity" }
      }
    }
  },
  "variants": {
    "default": {
      "name": "NestJS Microservices + Blockchain",
      "description": "Microservices with gRPC, RabbitMQ, blockchain integration",
      "patterns": {
        "use_typeorm": true, "use_mongoose": true, "use_dependency_injection": true,
        "use_guards": true, "use_interceptors": true, "use_grpc": true,
        "use_rabbitmq": true, "use_redis": true, "use_blockchain": true,
        "use_hyperledger_fabric": true
      },
      "specialists": {
        "core": ["nestjs-module-specialist", "nestjs-controller-specialist", "nestjs-service-specialist", "nestjs-middleware-specialist", "nestjs-testing-specialist"],
        "blockchain": ["fabric-network-setup-specialist", "fabric-gateway-transactions-specialist", "fabric-chaincode-lifecycle-specialist", "chaincode-core-specialist", "chaincode-queries-keys-specialist", "chaincode-advanced-specialist"],
        "blockchain_sdk": ["fabric-sdk-client-gateway-specialist", "fabric-sdk-transactions-events-specialist", "fabric-sdk-wallet-identity-specialist"],
        "grpc": ["grpc-service-definition-specialist", "nestjs-grpc-client-specialist", "nestjs-grpc-server-specialist"],
        "data": ["nestjs-typeorm-specialist", "nestjs-rabbitmq-specialist", "nestjs-redis-specialist"],
        "infrastructure": ["nestjs-nx-specialist", "nestjs-docker-specialist"]
      },
      "specialistDir": "nestjs-blockchain",
      "kb_path": {
        "backend": ".claude/utils/knowledge-base/backend-kb-nestjs-blockchain.json",
        "database": ".claude/utils/knowledge-base/database-kb-postgres.json"
      }
    }
  }
}
