{
  "$comment": "TypeScript React (SPA) stack",
  "name": "TypeScript React",
  "language": "typescript",
  "framework": "react",
  "version": { "typescript": "5.x", "react": "19.x" },
  "extensions": [".ts", ".tsx", ".js", ".jsx"],
  "parsing": {
    "parser": "typescript-parser",
    "extractor": "react-extractor",
    "patterns": {
      "component": { "namePrefix": null, "exports": ["function *", "const *: FC"], "nodeType": "Component" },
      "hook": { "namePrefix": "use", "files": ["use*.ts", "use*.tsx"], "nodeType": "Hook" },
      "context": { "nameSuffix": ["Context", "Provider"], "exports": ["createContext"], "nodeType": "Context" },
      "store": { "imports": ["@reduxjs/toolkit", "zustand"], "nodeType": "Component" }
    }
  },
  "architecture": {
    "supportedArchitectures": ["feature-sliced-design", "atomic-design", "layered", "clean-architecture"],
    "defaultArchitecture": null,
    "autoDetection": {
      "feature-sliced-design": { "requiredDirs": ["features", "entities", "shared"], "confidence": 0.9 },
      "atomic-design": { "requiredDirs": ["atoms", "molecules", "organisms", "templates", "pages"], "confidence": 0.9 },
      "layered": { "requiredDirs": ["components", "hooks", "services", "store"], "confidence": 0.7 }
    },
    "layerMappings": {
      "atomic-design": {
        "atoms": { "pathPatterns": ["**/atoms/**"], "description": "Basic building blocks (buttons, inputs)", "stereotype": "Atom" },
        "molecules": { "pathPatterns": ["**/molecules/**"], "description": "Simple combinations of atoms", "stereotype": "Molecule" },
        "organisms": { "pathPatterns": ["**/organisms/**"], "description": "Complex UI sections", "stereotype": "Organism" },
        "templates": { "pathPatterns": ["**/templates/**"], "description": "Page layouts without data", "stereotype": "Template" },
        "pages": { "pathPatterns": ["**/pages/**"], "description": "Complete pages with data", "stereotype": "Page" }
      }
    }
  },
  "variants": {
    "default": {
      "name": "React SPA + Material-UI",
      "description": "React SPA with Redux Toolkit and Material-UI",
      "patterns": {
        "use_react_19": true, "use_redux_toolkit": true, "use_material_ui": true
      },
      "specialists": {
        "ui": ["redux-toolkit-specialist", "material-ui-specialist"],
        "build": ["vite-specialist"],
        "testing": ["react-testing-specialist"],
        "security": ["react-security-specialist"]
      },
      "specialistDir": "react",
      "kb_path": {
        "frontend": ".claude/utils/knowledge-base/frontend-kb-redux-mui.json"
      }
    },
    "csharp-spa": {
      "name": "React SPA for C# Backend",
      "description": "React SPA with TanStack Query for C# .NET backend",
      "patterns": {
        "use_react_19": true, "use_tanstack_query": true
      },
      "specialists": [
        "react-component-specialist", "react-hooks-specialist", "react-query-specialist",
        "react-axios-specialist", "react-websocket-specialist", "react-state-specialist",
        "react-testing-specialist", "react-security-specialist"
      ],
      "specialistDir": "csharp-simplified",
      "kb_path": {
        "frontend": ".claude/utils/knowledge-base/frontend-kb-react-query.json"
      }
    }
  }
}
