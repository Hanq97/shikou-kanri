// Prisma schema for shikou-kanri backend
// Reference: ADR-004 (Database) — PostgreSQL 16 + extensions
// Phase 1: F8-auth + base User entity

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, uuid_ossp(map: "uuid-ossp"), pg_trgm, unaccent]
}

// =============================================================================
// Enums
// =============================================================================

enum UserRole {
  system_admin
  manager
  employee
  invited
}

enum UserStatus {
  pending_invite
  active
  suspended
  disabled
}

enum AuthProvider {
  local
  google
  microsoft
}

enum RefreshTokenRevokedReason {
  logout
  rotated
  reuse_detected
  admin_revoke
  family_revoked
  password_change
  account_suspended
  account_disabled
}

// F1 enums

enum CustomerType {
  individual
  corporate
}

enum PropertyType {
  new_construction
  remodel
  single_family
  multi_family
  commercial
  other
}

enum PropertyStructure {
  wood
  steel
  rc
  other
}

enum ProjectType {
  new_construction
  remodel
  repair
  aftercare
}

enum ProjectStatus {
  quoting
  received
  construction
  completed
  handed_over
  cancelled
}

enum ProjectMemberRole {
  owner
  contributor
  inspector
  invited_worker
}

enum FolderType {
  document
  drawing
  schedule
  photo
  chalkboard
  inspection
  custom
}

// =============================================================================
// Core entities
// =============================================================================

model User {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  name          String
  nameKana      String?      @map("name_kana")
  passwordHash  String?      @map("password_hash")

  role         UserRole
  status       UserStatus   @default(active)
  authProvider AuthProvider @default(local) @map("auth_provider")
  externalId   String?      @map("external_id")

  twoFaEnabled       Boolean @default(false) @map("two_fa_enabled")
  twoFaSecret        Bytes?  @map("two_fa_secret")
  twoFaRecoveryCodes Bytes?  @map("two_fa_recovery_codes")
  twoFaPendingSecret Bytes?  @map("two_fa_pending_secret")
  twoFaPendingUntil  DateTime? @map("two_fa_pending_until") @db.Timestamptz(6)

  failedLoginAttempts  Int       @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz(6)
  requireAdminUnlock   Boolean   @default(false) @map("require_admin_unlock")
  lastLoginAt          DateTime? @map("last_login_at") @db.Timestamptz(6)
  forcePasswordChange  Boolean   @default(false) @map("force_password_change")
  forceTwoFaEnrollment Boolean   @default(false) @map("force_two_fa_enrollment")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdById String? @map("created_by") @db.Uuid
  updatedById String? @map("updated_by") @db.Uuid

  refreshTokens   RefreshToken[]
  passwordResets  PasswordResetToken[]
  invitationsSent Invitation[] @relation("InvitedBy")
  auditLogs       AuditLog[] @relation("Actor")

  // F1 relations
  customersCreated  Customer[]      @relation("CustomerCreator")
  customersUpdated  Customer[]      @relation("CustomerUpdater")
  propertiesCreated Property[]      @relation("PropertyCreator")
  propertiesUpdated Property[]      @relation("PropertyUpdater")
  projectsOwned     Project[]       @relation("ProjectOwner")
  projectsCreated   Project[]       @relation("ProjectCreator")
  projectsUpdated   Project[]       @relation("ProjectUpdater")
  projectMembers    ProjectMember[]
  savedSearches     SavedSearch[]

  // F2 relations
  quotesApproved    Quote[]         @relation("QuoteApprover")
  quotesCreated     Quote[]         @relation("QuoteCreator")
  quotesUpdated     Quote[]         @relation("QuoteUpdater")
  quoteVersions     QuoteVersion[]
  unitPricesCreated UnitPrice[]     @relation("UnitPriceCreator")
  unitPricesUpdated UnitPrice[]     @relation("UnitPriceUpdater")

  // F6 relations
  maintenanceSchedulesCreated MaintenanceSchedule[] @relation("MaintenanceScheduleCreator")
  maintenanceSchedulesUpdated MaintenanceSchedule[] @relation("MaintenanceScheduleUpdater")
  aftercareRecordsCreated     AftercareRecord[]     @relation("AftercareRecordCreator")
  aftercareRecordsUpdated     AftercareRecord[]     @relation("AftercareRecordUpdater")
  aftercareRecordsHandled     AftercareRecord[]     @relation("AftercareRecordHandler")

  @@map("users")
  @@index([status])
  @@index([role, status])
}

model RefreshToken {
  id            String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String                      @map("user_id") @db.Uuid
  tokenHash     String                      @unique @map("token_hash")
  familyId      String                      @map("family_id") @db.Uuid
  lineageSeq    Int                         @default(0) @map("lineage_seq")
  issuedAt      DateTime                    @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt     DateTime                    @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?                   @map("revoked_at") @db.Timestamptz(6)
  revokedReason RefreshTokenRevokedReason? @map("revoked_reason")
  userAgent     String?                     @map("user_agent")
  ipAddress     String?                     @map("ip_address") @db.Inet

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([userId, expiresAt])
  @@index([familyId])
  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@index([userId, createdAt])
}

model Invitation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String
  name        String?
  tokenHash   String    @unique @map("token_hash")
  role        UserRole
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(6)
  invitedById String    @map("invited_by") @db.Uuid
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  invitedBy User @relation("InvitedBy", fields: [invitedById], references: [id])

  @@map("invitations")
  @@index([email, expiresAt])
}

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id") @db.Uuid
  changes     Json?
  ipAddress   String?   @map("ip_address") @db.Inet
  userAgent   String?   @map("user_agent")
  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actor User? @relation("Actor", fields: [actorUserId], references: [id])

  @@map("audit_logs")
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([entityType, entityId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
}

// =============================================================================
// F1: 顧客 + 物件 + 案件 entities
// =============================================================================

model Customer {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerType CustomerType @map("customer_type")
  name         String       @db.VarChar(200)
  nameKana     String?      @map("name_kana") @db.VarChar(200)
  phone        String?      @db.VarChar(20)
  email        String?      @db.VarChar(255)
  address      String?      @db.Text
  isOb         Boolean      @default(false) @map("is_ob")
  acquiredAt   DateTime?    @map("acquired_at") @db.Date
  notes        String?      @db.Text
  // search_text tsvector GENERATED column added via raw SQL migration

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid

  createdBy        User?             @relation("CustomerCreator", fields: [createdById], references: [id])
  updatedBy        User?             @relation("CustomerUpdater", fields: [updatedById], references: [id])
  properties       Property[]
  projects         Project[]
  aftercareRecords AftercareRecord[]

  @@map("customers")
  @@index([phone])
  @@index([nameKana])
  @@index([isOb, deletedAt])
  @@index([createdAt(sort: Desc)])
}

model Property {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String            @map("customer_id") @db.Uuid
  address      String            @db.Text
  propertyType PropertyType      @map("property_type")
  structure    PropertyStructure
  yearBuilt    Int?              @map("year_built")
  handoverDate DateTime?         @map("handover_date") @db.Date
  floorAreaSqm Decimal?          @map("floor_area_sqm") @db.Decimal(8, 2)
  photoUrls    String[]          @map("photo_urls")
  notes        String?           @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid

  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy            User?                 @relation("PropertyCreator", fields: [createdById], references: [id])
  updatedBy            User?                 @relation("PropertyUpdater", fields: [updatedById], references: [id])
  projects             Project[]
  maintenanceSchedules MaintenanceSchedule[]
  aftercareRecords     AftercareRecord[]

  @@map("properties")
  @@index([customerId, deletedAt])
  @@index([handoverDate])
}

model Project {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectCode   String        @unique @map("project_code") @db.VarChar(20)
  customerId    String        @map("customer_id") @db.Uuid
  propertyId    String?       @map("property_id") @db.Uuid
  projectType   ProjectType   @map("project_type")
  status        ProjectStatus @default(quoting)
  name          String        @db.VarChar(200)
  description   String?       @db.Text
  ownerUserId   String        @map("owner_user_id") @db.Uuid
  scheduleStart DateTime?     @map("schedule_start") @db.Date
  scheduleEnd   DateTime?     @map("schedule_end") @db.Date
  actualStart   DateTime?     @map("actual_start") @db.Date
  actualEnd     DateTime?     @map("actual_end") @db.Date
  amountTotal   Decimal?      @map("amount_total") @db.Decimal(15, 0)
  // search_text tsvector GENERATED column added via raw SQL migration

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid

  customer  Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  property  Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  owner     User            @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  createdBy User?           @relation("ProjectCreator", fields: [createdById], references: [id])
  updatedBy User?           @relation("ProjectUpdater", fields: [updatedById], references: [id])
  members   ProjectMember[]
  folders   Folder[]
  quotes    Quote[]

  @@map("projects")
  @@index([status, scheduleStart])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([ownerUserId, deletedAt])
}

model ProjectMember {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId            String            @map("project_id") @db.Uuid
  userId               String            @map("user_id") @db.Uuid
  roleOnProject        ProjectMemberRole @map("role_on_project")
  folderAccessOverride Json?             @map("folder_access_override")
  invitedAt            DateTime          @default(now()) @map("invited_at") @db.Timestamptz(6)
  revokedAt            DateTime?         @map("revoked_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@map("project_members")
  @@index([userId, revokedAt])
}

model Folder {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId          String     @map("project_id") @db.Uuid
  name               String     @db.VarChar(100)
  folderType         FolderType @map("folder_type")
  isPublicForInvited Boolean    @default(false) @map("is_public_for_invited")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("folders")
  @@index([projectId, folderType])
}

model SavedSearch {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  scope      String   @db.VarChar(50)
  name       String   @db.VarChar(100)
  filterJson Json     @map("filter_json")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, name])
  @@map("saved_searches")
  @@index([userId, scope])
}

// =============================================================================
// F2: Quote management
// =============================================================================

enum QuoteStatus {
  draft
  submitted
  pending_admin
  approved
  rejected
  sent
  won
  lost
}

enum QuoteChangeType {
  correction
  deletion
  status_change
}

model Quote {
  id                     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteNumber            String      @map("quote_number") @db.VarChar(30)
  projectId              String      @map("project_id") @db.Uuid
  versionNo              Int         @default(1) @map("version_no")
  version                Int         @default(0)
  status                 QuoteStatus @default(draft)
  issuedAt               DateTime    @map("issued_at") @db.Date
  validUntil             DateTime?   @map("valid_until") @db.Date
  counterPartyName       String      @map("counter_party_name") @db.VarChar(200)
  amountSubtotal         Decimal     @default(0) @map("amount_subtotal") @db.Decimal(15, 0)
  amountTax              Decimal     @default(0) @map("amount_tax") @db.Decimal(15, 0)
  amountTotal            Decimal     @default(0) @map("amount_total") @db.Decimal(15, 0)
  notes                  String?     @db.Text
  qualifiedInvoiceNumber String?     @map("qualified_invoice_number") @db.VarChar(20)
  approvedById           String?     @map("approved_by") @db.Uuid
  approvedAt             DateTime?   @map("approved_at") @db.Timestamptz(6)
  sentAt                 DateTime?   @map("sent_at") @db.Timestamptz(6)

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  approvedBy User?          @relation("QuoteApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy  User?          @relation("QuoteCreator", fields: [createdById], references: [id])
  updatedBy  User?          @relation("QuoteUpdater", fields: [updatedById], references: [id])
  lines      QuoteLine[]
  versions   QuoteVersion[]

  @@map("quotes")
  @@unique([quoteNumber, versionNo])
  @@index([projectId])
  @@index([issuedAt(sort: Desc)])
  @@index([amountTotal])
  @@index([status])
}

model QuoteLine {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId             String   @map("quote_id") @db.Uuid
  sortOrder           Int      @map("sort_order")
  category            String?  @db.VarChar(50)
  itemName            String   @map("item_name") @db.VarChar(200)
  description         String?  @db.Text
  unit                String   @db.VarChar(20)
  quantity            Decimal  @db.Decimal(15, 2)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(15, 0)
  amount              Decimal  @db.Decimal(15, 0)
  taxRate             Decimal  @default(0.10) @map("tax_rate") @db.Decimal(5, 2)
  isOptional          Boolean  @default(false) @map("is_optional")
  unitPriceMasterId   String?  @map("unit_price_master_id") @db.Uuid

  quote           Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  unitPriceMaster UnitPrice? @relation(fields: [unitPriceMasterId], references: [id], onDelete: SetNull)

  @@map("quote_lines")
  @@index([quoteId, sortOrder])
}

model QuoteVersion {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId      String          @map("quote_id") @db.Uuid
  versionNo    Int             @map("version_no")
  changeType   QuoteChangeType @map("change_type")
  changeReason String          @map("change_reason") @db.Text
  snapshot     Json
  changedById  String          @map("changed_by") @db.Uuid
  changedAt    DateTime        @default(now()) @map("changed_at") @db.Timestamptz(6)

  quote     Quote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  changedBy User  @relation(fields: [changedById], references: [id])

  @@map("quote_versions")
  @@index([quoteId, changedAt(sort: Desc)])
}

model UnitPrice {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String   @unique @db.VarChar(30)
  category         String?  @db.VarChar(50)
  itemName         String   @map("item_name") @db.VarChar(200)
  description      String?  @db.Text
  unit             String   @db.VarChar(20)
  defaultUnitPrice Decimal  @map("default_unit_price") @db.Decimal(15, 0)
  supplierName     String?  @map("supplier_name") @db.VarChar(200)
  isActive         Boolean  @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid

  createdBy  User?       @relation("UnitPriceCreator", fields: [createdById], references: [id])
  updatedBy  User?       @relation("UnitPriceUpdater", fields: [updatedById], references: [id])
  quoteLines QuoteLine[]

  @@map("unit_prices")
  @@index([category, isActive])
}

// =============================================================================
// F6 — Aftercare (点検・アフター対応)
// =============================================================================

enum MaintenanceScheduleType {
  one_year
  three_year
  five_year
  ten_year
  custom
}

enum MaintenanceScheduleStatus {
  pending
  notified
  overdue
  completed
  cancelled
}

enum AftercareRecordType {
  inspection
  repair
  inquiry
  complaint
  other
}

enum AftercareRecordStatus {
  open
  in_progress
  resolved
  closed
}

model MaintenanceSchedule {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId         String                    @map("property_id") @db.Uuid
  scheduleType       MaintenanceScheduleType   @map("schedule_type")
  scheduledDate      DateTime                  @map("scheduled_date") @db.Date
  status             MaintenanceScheduleStatus @default(pending)
  notifiedAt         DateTime?                 @map("notified_at") @db.Timestamptz(6)
  completedAt        DateTime?                 @map("completed_at") @db.Timestamptz(6)
  completedRecordId  String?                   @map("completed_record_id") @db.Uuid
  notes              String?                   @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid

  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  completedRecord AftercareRecord? @relation("ScheduleCompletedBy", fields: [completedRecordId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("MaintenanceScheduleCreator", fields: [createdById], references: [id])
  updatedBy       User?            @relation("MaintenanceScheduleUpdater", fields: [updatedById], references: [id])
  aftercareRecords AftercareRecord[] @relation("ScheduleRecords")

  @@map("maintenance_schedules")
  @@index([propertyId, scheduledDate])
  @@index([status, scheduledDate])
  @@index([scheduledDate])
}

model AftercareRecord {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String                @map("customer_id") @db.Uuid
  propertyId      String?               @map("property_id") @db.Uuid
  scheduleId      String?               @map("schedule_id") @db.Uuid
  recordType      AftercareRecordType   @map("record_type")
  status          AftercareRecordStatus @default(open)
  occurredAt      DateTime              @map("occurred_at") @db.Date
  title           String                @db.VarChar(200)
  description     String                @db.Text
  handledById     String?               @map("handled_by") @db.Uuid
  resolvedAt      DateTime?             @map("resolved_at") @db.Timestamptz(6)
  resolutionNotes String?               @map("resolution_notes") @db.Text

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdById String?   @map("created_by") @db.Uuid
  updatedById String?   @map("updated_by") @db.Uuid

  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  property            Property?            @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  schedule            MaintenanceSchedule? @relation("ScheduleRecords", fields: [scheduleId], references: [id], onDelete: SetNull)
  handledBy           User?                @relation("AftercareRecordHandler", fields: [handledById], references: [id])
  createdBy           User?                @relation("AftercareRecordCreator", fields: [createdById], references: [id])
  updatedBy           User?                @relation("AftercareRecordUpdater", fields: [updatedById], references: [id])
  completedSchedules  MaintenanceSchedule[] @relation("ScheduleCompletedBy")

  @@map("aftercare_records")
  @@index([customerId, occurredAt(sort: Desc)])
  @@index([propertyId, occurredAt(sort: Desc)])
  @@index([status, occurredAt])
}
