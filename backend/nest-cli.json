{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "projects": {
    "cli": {
      "type": "application",
      "root": ".",
      "entryFile": "cli",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.json",
        "deleteOutDir": false
      }
    }
  },
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/notification/templates/**/*.hbs",
        "outDir": "dist/src"
      }
    ],
    "watchAssets": true
  }
}
