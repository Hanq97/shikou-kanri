# Backend environment variables — copy to .env and edit values
# DO NOT commit .env to git

# --- Application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
TZ=Asia/Tokyo

# --- Database (matches docker-compose.dev.yml) ---
DATABASE_URL=postgresql://shikou:shikou_dev_password@localhost:5432/shikou_kanri_dev?schema=public

# --- Redis (BullMQ + cache) ---
REDIS_URL=redis://localhost:6379

# --- JWT (per ADR-015) ---
# Generate strong secret: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-strong-secret-min-32-chars
JWT_ACCESS_TTL=30m
JWT_REFRESH_SECRET=replace-with-different-strong-secret
JWT_REFRESH_TTL=7d

# --- 2FA (TOTP secret encryption key) ---
# AES-256 key (32 bytes hex = 64 chars)
TWOFA_ENCRYPTION_KEY=replace-with-32-byte-hex-key

# --- Email (dev via Mailhog) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@shikou-kanri.local

# --- AWS (Phase 1: S3 mock OK; Phase 2+: real values) ---
AWS_REGION=ap-northeast-1
S3_BUCKET=shikou-kanri-dev
# AWS_ACCESS_KEY_ID=  # Use IAM role in prod
# AWS_SECRET_ACCESS_KEY=

# --- Bedrock (Phase 3, leave commented in Phase 1) ---
# BEDROCK_REGION=ap-northeast-1
